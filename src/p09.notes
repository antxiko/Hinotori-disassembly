



# --- A MANO, POR TANDAS (seccion que reescribe tools/mete_notas.py desde work/notas_pNN.txt) ---
L 0xB880 arranca_king_kong_2
L 0xB8BD ranura_de_la_pagina_1
L 0xB8D6 lee_una_palabra_del_otro
L 0xB8EA copia_su_init
L 0xB919 copia_el_gancho
C 0xB880 la ranura de Hinotori...
C 0xB883 ...en 0xF100
C 0xB886 el INIT de King Kong 2: su palabra 0x4002...
C 0xB88C ...en 0xF102
C 0xB890 0xA0 bytes de 0xF87F hacia atras a cero
C 0xB898 256 bytes de su INIT a 0xF120
C 0xB89B el gancho de Hinotori a 0xF220
C 0xB89E la interrupcion...
C 0xB8A1 ...y a arrancar King Kong 2 desde la copia
C 0xB8A4 el gancho H.TIMI, a 0xF220...
C 0xB8AF ...sin nada pendiente (0xF106)
C 0xB8B5 y la pagina 1, la del otro cartucho
C 0xB8BD la ranura de la pagina 1 (con la secundaria si esta expandida)
C 0xB8D6 una palabra de la otra ranura (RDSLT dos veces)
C 0xB8EA 256 bytes del otro desde su INIT...
C 0xB8F4 ...con RDSLT...
C 0xB8FC ...a 0xF120
C 0xB901 en la copia se busca el primer 0xA0 0xFD...
C 0xB90D (un ld (0xFDA0),hl: donde King Kong 2 pone su gancho)
C 0xB912 ...y se cambia para que lo deje en 0xF104
C 0xB919 0xAA bytes de p09:B925 a 0xF220
L 0xB9CF graba_king_kong_2
L 0xBA9C carga_king_kong_2
C 0xB9CF el paso de grabar (0xF108)
C 0xB9DF la ventana y SAVE MODE / INPUT FILE NAME
C 0xB9EE al paso siguiente
C 0xB9F3 teclear el nombre (6 letras)...
C 0xB9F6 ...ESC: se deja
C 0xBA01 RETURN: a grabar
C 0xBA0C la cinta en marcha, cabecera larga (TAPOON)
C 0xBA11 diez 0xEA...
C 0xBA16 ...(TAPOUT)
C 0xBA1F y el nombre, 6 bytes
C 0xBA34 cabecera corta
C 0xBA3B los trozos de RAM de la lista de p09:BCFB: [desde][cuantos]...
C 0xBA4B ...byte a byte a la cinta
C 0xBA5E la cinta parada (TAPOOF) y el mensaje de hecho
C 0xBA6A OK? Y: vuelta al juego; N: otra vez
C 0xBA84 error de cinta: se para y se avisa
C 0xBA9C el paso de cargar
C 0xBAA8 la ventana y LOAD MODE / INPUT FILE NAME
C 0xBABA teclear el nombre
C 0xBACE la cinta en marcha (TAPION)...
C 0xBAD7 ...hasta diez 0xEA seguidos
C 0xBAE4 el nombre de la cinta...
C 0xBAF4 ...contra el tecleado
C 0xBB05 FOUND y el nombre
C 0xBB0E la segunda cabecera
C 0xBB13 los trozos de RAM de p09:BCFB, de la cinta a su sitio
C 0xBB36 la cinta parada (TAPIOF)
C 0xBB39 se borra la ventana y se vuelve a King Kong 2...
C 0xBB42 ...con lo que haga falta arreglado para seguir
C 0xBB56 ya no se graba ni se carga (0xF107)
C 0xBB70 el sonido de King Kong 2 en marcha
C 0xBB73 y a volver: 0xF2BB devuelve las ranuras de King Kong 2
C 0xBB91 error: se para la cinta y se avisa
C 0xBBA3 otro nombre: se sigue buscando
C 0xBBAC pinta el nombre encontrado
C 0xBBB5 0x28 bytes de 0xFBF0 a cero: el teclado de la BIOS
C 0xBBC5 la ventana: dos rectangulos negros
C 0xBBD9 una tecla (CHGET)...
C 0xBBEC ...ESC...
C 0xBBF0 ...RETURN...
C 0xBBF4 ...BS...
C 0xBBF8 ...cifras...
C 0xBBFE ...mayusculas...
C 0xBC04 ...y minusculas, que pasan a mayusculas
C 0xBC0D la letra al nombre, hasta 6
C 0xBC20 BS: la de antes fuera
C 0xBC34 el nombre a la pantalla, 6 letras
C 0xBC49 0x0E bytes de 0xF109 a cero
L 0xBD31 ventana_power_up
C 0xBD31 hay un cuadro pendiente de otra cosa: a jugar
C 0xBD3A el paso de la ventana
C 0xBD42 el sonido 0x2F
C 0xBD4A la ventana: un marco...
C 0xBD5A ...y el fondo
C 0xBD63 POWER UP
C 0xBD69 los niveles de POWER UP...
C 0xBD6C ...y la vida
C 0xBD6F el icono de Gao...
C 0xBD7D ...y su cuenta
C 0xBDA3 un cuadro gris de 0x14 x 0x14
C 0xBDB1 la vida: tres cifras en blanco...
C 0xBDCB ...0xC845 a BCD...
C 0xBDE0 ...y pintada
C 0xBDF6 el nivel de POWER UP (0 cuenta como 1)
C 0xBE08 el marco del nivel elegido
C 0xBE0B su sitio: 0x3C + 26*(nivel - 1)
C 0xBE26 los seis iconos de los niveles, uno cada 26 puntos
C 0xBE32 el icono...
C 0xBE38 ...el siguiente
C 0xBE42 y los textos de abajo
C 0xBE68 un icono de 16x16 con LMMM
C 0xBE73 su precio, de p09:BE89...
C 0xBE80 ...pintado debajo
C 0xB8C0 la ranura primaria...
C 0xB8C7 ...si esta expandida...
C 0xB8D1 ...la secundaria
C 0xBB23 un byte de la cinta...
C 0xBB2C ...a su sitio
C 0xBB2E los BC del trozo
C 0xBA3E [desde]...
C 0xBA43 ...0: se acabo...
C 0xBA46 ...[cuantos]
C 0xBB16 [desde]...
C 0xBB1B ...0: se acabo...
C 0xBB1E ...[cuantos]
# --- fin de las notas por tandas ---

