
# --- A MANO, POR TANDAS (seccion que reescribe tools/mete_notas.py desde work/notas_pNN.txt) ---
L 0x6B1A piezas_de_las_fichas_dc00
L 0x6B21 piezas_de_las_fichas_d700
L 0x6B36 prepara_las_piezas
C 0x6B1A las 8 fichas de 0xDC00...
C 0x6B21 ...o las 10 de 0xD700
C 0x6B28 las ocupadas (tipo distinto de 0)
C 0x6B2F la siguiente, 0x80 bytes mas alla
C 0x6B36 ix+0x10: el juego de piezas del sprite
C 0x6B3B bit 7: ya preparado
C 0x6B40 la definicion: palabra de p02:9407 + 2*juego
C 0x6B4C ix+0x20: cuantas piezas
C 0x6B52 el primer byte dice como se colocan:
C 0x6B53 0x80, 0x81, 0x82, 0x83: en cuadros de 2x2, 1x2... (p01:6B9F-6BBB)
C 0x6B63 si no, 3 bytes por pieza: dy, dx y dibujo
C 0x6B66 una pieza a la ficha (ix+0x22..)
C 0x6B73 0x83: las colocaciones de p01:6BBB
C 0x6B79 0x82: las de p01:6BAB
C 0x6B7F 0x81: las de p01:6BA7
C 0x6B85 0x80: las de p01:6B9F
C 0x6B8A dy y dx de la tabla...
C 0x6B96 ...y el dibujo de la definicion
C 0x6B9C las B piezas
L 0x6BD3 pinta_las_fichas_dc00
L 0x6BDC pinta_las_fichas_d700
L 0x6BF3 pinta_las_piezas
C 0x6BD3 las piezas de las 8 fichas de 0xDC00 a los sprites...
C 0x6BDC ...y las de las 10 de 0xD700, con su patron de 0xCF00
C 0x6BF3 el primer patron: el de la ficha...
C 0x6BF7 ...o el sitio donde su area subio la cosa (0xCF00 + tipo)
C 0x6C03 la y y la x de la ficha, en los registros alternativos
C 0x6C09 ix+0x20: cuantas piezas
C 0x6C10 una pieza: su sprite (0xE628 + 4*n)...
C 0x6C1B ...y = la de la ficha + dy...
C 0x6C22 ...x = la de la ficha + dx...
C 0x6C2D ...patron = el primero + el de la pieza
C 0x6C34 sin color: el sprite fuera (y = 0xE1)
C 0x6C41 0xC4BE: se vuelven a poner los colores
C 0x6C49 bit 7: los colores ya estan
C 0x6C4D el color de la pieza, de p01:7250...
C 0x6C5C ...en las 16 lineas del sprite
C 0x6C62 la pieza siguiente
L 0x6D48 un_bicho_del_area
C 0x6D48 una entrada de la lista que va saliendo
C 0x6D4C cuenta atras hasta el siguiente
C 0x6D57 C: el tipo; DE: y, x; B: el dato
C 0x6D66 el dato...
C 0x6D6B ...0xD411 a 0...
C 0x6D6E ...y el tipo, a 0xE800
C 0x6D76 una ficha libre de las 10 de 0xD700
C 0x6D86 la ficha nueva es ix
C 0x6D8C cuantos sprites lleva el tipo (p01:6F21)
C 0x6D9A 0: ninguno, se crea sin buscar sitio
C 0x6D9E 1: uno solo
C 0x6DA1 2 o mas: se buscan sprites libres (0xE0) de dos en dos...
C 0x6DA7 ...entre los 0xC4A8 que hay
C 0x6DB0 uno libre: se coge (0xE1)
C 0x6DBE ...y el de al lado tambien libre...
C 0x6DC7 ...los dos
C 0x6DDE ocupado: el siguiente par
C 0x6DE9 no han salido todos: se sueltan los que se cogieron
C 0x6DF7 sprite a 0xE0: libre
C 0x6E08 1: un sprite libre cualquiera
L 0x7C76 choques_de_una_ficha
L 0x7CD0 una_caja_contra_los_disparos
L 0x7D23 una_caja_contra_un_disparo
C 0x7C76 la y de la ficha
C 0x7C7B por debajo de 0xF0: esta en pantalla
C 0x7C80 y la x
C 0x7C81 IY = (x, y)
C 0x7C84 ix+0x4E: las cajas de choque de la ficha
C 0x7C88 0: ninguna
C 0x7C8B bit 7: una caja
C 0x7C8F bit 6: cinco cajas
C 0x7C93 la primera...
C 0x7C9E ...si le han dado, se apunta
C 0x7CA2 y las demas, 8 bytes cada una
C 0x7CD0 C: lo que le ha dado
C 0x7CD4 la caja: su sitio respecto de la ficha...
C 0x7CDF ...su ancho y su alto
C 0x7CE5 contra que: bit 0 solo los de 0xEA08...
C 0x7CE9 ...bit 1 los de 0xEA08 en adelante
C 0x7CEC si no, los disparos de Gao desde el primero (0xEA00)
C 0x7CF8 uno a uno, hasta que no queden
C 0x7D23 el disparo: bit 7 de su primer byte, ya no vale
C 0x7D28 su y dentro de la caja?
C 0x7D2D ...y su x?
C 0x7D31 le ha dado: el disparo se gasta (1)
C 0x7D37 los 2 primeros son de Gao:
C 0x7D3D lo que hace depende del nivel 0xC840 (p01:7D70)
C 0x7D4C los de despues son los que tocan a Gao: si esta de pie...
C 0x7D52 ...y sin el objeto 3...
C 0x7D58 ...le dan (bit 2)
C 0x7D5F un cuadro menos de invulnerabilidad
C 0x7D66 lo que le ha dado, a la ficha
C 0x7D77 las 6 fichas especiales de 0xCA00...
C 0x7D85 ...si el disparo 0xEA09 les dio, 0xFF
C 0x7D96 las 10 fichas de 0xD700
C 0x7DA1 sus cajas contra los disparos...
C 0x7DA7 ...y si le han dado, que pasa
C 0x7DB3 la caja de la ficha (ix+0x6E..): x e y...
C 0x7DCD ...ancho y alto...
C 0x7DD1 ...y contra que
C 0x7DDA contra los disparos de Gao, los tres primeros restando invulnerabilidad
C 0x7E07 contra los de 0xEA08
C 0x7E22 el tipo de la ficha, a 0xC4C7
C 0x7E28 el tipo 0x0A...
C 0x7E2D ...y el 0x0B, aparte
C 0x7E32 con el objeto 5 y un golpe de Gao (bit 2)...
C 0x7E3C ...se apunta el golpe (ix+0x13)
C 0x7E40 ...muere del todo (ix+0x12 = 1, ix+0x13 = 2)
C 0x7E49 tipo 0x0A: con el objeto 5 o un golpe cualquiera, p02:9F9F
C 0x7E5B tipo 0x0B: con el objeto 5, a la ficha de ix+0x1A...
C 0x7E6B ...p02:9F9F
C 0x7E71 los disparos contra Gao (si no esta en el estado 2)
C 0x7E77 la caja de Gao (0xC820, 0xC821) menos 2
C 0x7E84 las 16 fichas de 0xCC00...
C 0x7E8A ...las de tipo 3
# --- fin de las notas por tandas ---

