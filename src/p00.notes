# Notas del banco 0: comentarios (C), etiquetas (L) y datos (D) anclados a direccion.

# --- La biblioteca del VDP y del armazon, identica byte a byte (operandos
# aparte) a la de King Kong 2 (tools/porta_nombres.py, tramos de 24 bytes o
# mas); cada linea se ha leido contra el codigo de aqui. ---
L 0x40A4 hl_mas_a
L 0x40A9 de_mas_a
L 0x40AE despacha
B 0x40AE Salta a la entrada A de la tabla de palabras que va pegada detras del `call`.
L 0x40AF despacha_hl
L 0x49EB cuenta_para_otir
L 0x49F3 copia_a_la_vram
C 0x49F3 BC bytes de HL a la VRAM de DE
L 0x4A06 rellena_la_vram
C 0x4A06 BC bytes con A desde la VRAM de HL
L 0x4A39 vram_para_escribir
C 0x4A39 prepara el V9938 para escribir en la direccion de VRAM HL (R#14 y el puerto 1)
L 0x4A58 vram_para_leer
L 0x49D8 lee_de_la_vram
L 0x4A87 rle_con_destino
C 0x4A87 la palabra de DE es la direccion de VRAM; detras, el RLE
L 0x4A8D rle_a_la_vram
C 0x4A8D el RLE de DE a la VRAM de HL (n con el bit 7: n bytes tal cual; sin el, repetir; 0 acaba)
L 0x4D03 pon_un_color
C 0x4D03 color A de la paleta = D (RB) y E (G)
L 0x4D2D paleta_inicial
L 0x4D3F pon_paleta
C 0x4D3F lista [color][RB][G] ... 0xFF
L 0x4D4D espera_al_vdp
C 0x4D4D espera a que el V9938 acabe la orden (bit 0 de S#2)
L 0x4D56 lee_estado_del_vdp
C 0x4D56 lee el registro de estado A del V9938
L 0x4DDD marco
C 0x4DDD cuatro rayas: un marco de E por D en HL
L 0x4E0B hmmv
L 0x4E47 hmmm
C 0x4E47 orden HMMM del V9938: copia BxC puntos de (H, L) a (D, E); A lleva las paginas
L 0x4E8B lmmm
C 0x4E8B orden LMMM del V9938: lo mismo con operacion logica (A: paginas y operacion; 8 = TIMP)
L 0x4ED7 sube_letras
C 0x4ED7 B letras de 1 bit de HL, en color C, a la hoja de la pagina 1 desde (D, E)
L 0x4EE0 sube_una_letra
L 0x4F01 sube_un_dibujo
C 0x4F01 un dibujo de 8x8 a 4 bits (32 bytes) de HL a la VRAM de DE
L 0x4F16 sube_dibujos
C 0x4F16 B dibujos de 8x8 a 4 bits de HL a la VRAM de DE
L 0x5037 pon_dibujo_transparente
C 0x5037 lo mismo con LMMM + TIMP: el color 0 no pinta
L 0x5049 copia_dibujo_en_la_hoja
L 0x505B copia_8x8_en_la_hoja
L 0x4D76 raya_horizontal
C 0x4D76 orden LINE del V9938 (MAJ = 0): de (H, L), B-1 puntos
L 0x4DA9 raya_vertical
C 0x4DA9 orden LINE con MAJ = 1: la raya va hacia abajo
L 0x4DF7 raya_vertical_guardando
L 0x4E01 raya_horizontal_guardando
L 0x4CED apaga_los_sprites
L 0x4CF8 enciende_los_sprites
C 0x4091 0xC105: el juego no se mete dos veces (si el cuadro anterior no acabo)
C 0x409B p00:4200: el juego entero, un cuadro
C 0x40B8 INIT: el cartucho arranca aqui (cabecera AB)
C 0x40B9 la pila, debajo de las copias del mapper
C 0x40BC la ranura primaria de la pagina 1 (la del cartucho)...
C 0x40C6 ...y si esta expandida, la secundaria (0xFCC1 + ranura)...
C 0x40D7 ...para poner el cartucho tambien en la pagina 2 (0x8000-0xBFFF)
C 0x40DC 0x30EF ceros desde 0xC000: toda la RAM del juego
C 0x49D8 LEE BC bytes de la VRAM de HL a DE
C 0x49DB B y A: las vueltas de 256 de inir
C 0x49DF el puerto de datos del VDP (0x0006 de la BIOS)
C 0x49E4 una tanda de B bytes...
C 0x49E6 ...y otra, hasta A
C 0x49EB DE <-> HL; B = C (lo que sobra) y A = B, +1 si sobra algo: las vueltas de 256
C 0x49F4 el sitio de la VRAM
C 0x49FB el puerto de datos del VDP (0x0007 de la BIOS)
C 0x4A00 una tanda de B bytes...
C 0x4A02 ...y otra, hasta A
C 0x4A08 el sitio de la VRAM
C 0x4A0B D: lo que sobra de 256...
C 0x4A10 ...y B, las vueltas enteras
C 0x4A11 el puerto de datos
C 0x4A16 A, BC veces
C 0x4A3A el puerto de registros del VDP (el de datos + 1)
C 0x4A3E los dos bits altos de la direccion...
C 0x4A45 ...en R#14
C 0x4A4B el byte bajo...
C 0x4A4E ...y los seis siguientes, con el bit 6: para escribir
C 0x4A6D ...sin el bit 6: para leer
C 0x4A88 la direccion de VRAM de la palabra de DE
C 0x4A90 el puerto de datos
C 0x4A94 n
C 0x4A95 0: se acabo
C 0x4A98 con el bit 7...
C 0x4A9B ...sin el: repetir
C 0x4A9E 0x80: otra direccion de VRAM (p00:4A87)
C 0x4AA1 n & 0x7F bytes tal cual
C 0x4AA8 el byte que se repite, B veces
C 0x4CED la copia de R#8 (0xFFE7)...
C 0x4CF8 la copia de R#8 sin el bit 1: se ven los sprites
C 0x4D05 el numero de color
C 0x4D06 el puerto de registros
C 0x4D0C R#16 = el color...
C 0x4D12 ...y el puerto de la paleta: RB y G
C 0x4D1A y tambien en la copia de la paleta en la VRAM (0xF680 + 2*color)
C 0x4D25 RB y G a la VRAM
C 0x4D41 0xFF acaba
C 0x4D44 RB y G
C 0x4D52 el bit 0 de S#2 (CE): la orden sigue en marcha
C 0x4D5F R#15 = A...
C 0x4D65 ...se lee el registro de estado...
C 0x4D69 ...y R#15 vuelve a 0 (la BIOS lo espera asi)
C 0x4D7F desde R#36...
C 0x4D88 ...el puerto de los registros seguidos (R#17 auto)
C 0x4D8A DX = H
C 0x4D8F DY = L
C 0x4D93 lo largo: B - 1 puntos
C 0x4DA3 LINE con IMP
C 0x4DD4 ARG con MAJ = 1: el lado largo es el vertical
C 0x4DDE la raya de la izquierda (E puntos)
C 0x4DE2 la de arriba (D puntos)
C 0x4DE5 la de abajo: L + E - 1
C 0x4DEF la de la derecha: H + D - 1
C 0x4E0B el color, a un lado
C 0x4E15 desde R#36
C 0x4E20 DX = H
C 0x4E25 DY = L y la pagina D
C 0x4E29 NX = B (0 = 256)
C 0x4E33 NY = C (0 = 256)
C 0x4E3B CLR = el color
C 0x4E41 HMMV
C 0x4E4B desde R#32 (SX)
C 0x4E5C SX = H
C 0x4E61 SY = L...
C 0x4E64 ...y la pagina de origen: bits 0-1 de A
C 0x4E69 DX = D
C 0x4E6E DY = E...
C 0x4E70 ...y la pagina de destino: bits 2-3 de A
C 0x4E78 NX = B
C 0x4E7D NY = C
C 0x4E85 HMMM
C 0x4E8F desde R#32
C 0x4EA0 SX = H
C 0x4EA5 SY = L...
C 0x4EA8 ...y la pagina de origen: bits 6-7 de A
C 0x4EAF DX = D
C 0x4EB4 DY = E...
C 0x4EB6 ...y la pagina de destino: bits 4-5
C 0x4EBF NX = B
C 0x4EC4 NY = C
C 0x4ECC LMMM con la operacion de los bits 0-3 (8 = TIMP)
C 0x4EDD la siguiente letra
C 0x4EE3 1 bit a 4 bits, en 0xE800
C 0x4EE8 D y E cambiados...
C 0x4EEB ...y (y*256 + x)/2: el byte de la VRAM...
C 0x4EEF ...en la pagina 1 (0x8000)
C 0x4EF3 los 32 bytes de 0xE800
C 0x4EFA 8 bytes de fuente por letra
C 0x4F02 8 filas
C 0x4F05 de 4 bytes (8 puntos)
C 0x4F0C la fila de abajo: 128 bytes de VRAM
C 0x4F1A el siguiente, 4 bytes (8 puntos) a la derecha...
C 0x4F1D ...y al llegar al borde (0x80), 8 lineas mas abajo
C 0x4F28 el siguiente dibujo
C 0x503D 8x8 con LMMM y TIMP, de la pagina 1 a la 0
C 0x504F 8x8, dentro de la pagina 1
C 0x4D7A C = el puerto de control del VDP (0x0007 + 1)
C 0x4D8C DX alto = 0
C 0x4D91 DY alto = 0 (pagina 0)
C 0x4D95 NX (el lado largo) = B - 1...
C 0x4D98 ...su byte alto 0...
C 0x4D9A ...NY (el corto) = 0...
C 0x4D9F CLR = C, el color
C 0x4DA1 ARG = 0: MAJ 0, hacia la derecha
C 0x4DAD C = el puerto de control del VDP
C 0x4DBD DX = H
C 0x4DC2 DY = L
C 0x4DC7 NX (el lado largo) = B - 1
C 0x4DD2 CLR = C, el color
C 0x4DD7 LINE con IMP
C 0x4E10 C = el puerto de control del VDP
C 0x4E23 DX alto = 0
C 0x4E2C NX alto: 1 si NX es 0 (256 puntos)
C 0x4E35 NY alto: 1 si NY es 0
C 0x4E3E ARG = 0
C 0x4E4C C = el puerto de control del VDP
C 0x4E5E SX alto = 0
C 0x4E6B DX alto = 0
C 0x4E7A NX alto = 0
C 0x4E7F NY alto = 0, y R#44 (CLR) y R#45 (ARG) = 0
C 0x4E90 C = el puerto de control del VDP
C 0x4EA2 SX alto = 0
C 0x4EB1 DX alto = 0
C 0x4EC1 NX alto = 0
C 0x4EC6 NY alto = 0, CLR y ARG = 0
C 0x4D58 H = el puerto de control (0x0007), L = el de lectura (0x0006 + 1)
C 0x40AF SALTA A LA ENTRADA A de la tabla de palabras de HL
C 0x40B3 la palabra, y alli
C 0x498B bancos_1_2_3: LAS PUERTAS: A, A+1 y A+2 en los tres registros del mapper y en sus copias
C 0x49F7 cuenta_para_otir: DE <-> HL; B = C (lo que sobra) y A = B, +1 si sobra algo: las vueltas de 256
C 0x4D21 vram_para_escribir: prepara el V9938 para escribir en la direccion de VRAM HL (R#14 y el puerto 1)
C 0x4D48 pon_un_color: color A de la paleta = D (RB) y E (G)
C 0x4D4F lee_estado_del_vdp: lee el registro de estado A del V9938
C 0x4DFA raya_vertical: orden LINE con MAJ = 1: la raya va hacia abajo
C 0x4E04 raya_horizontal: orden LINE del V9938 (MAJ = 0): de (H, L), B-1 puntos
C 0x4E0C espera_al_vdp: espera a que el V9938 acabe la orden (bit 0 de S#2)
C 0x4E48 espera_al_vdp: espera a que el V9938 acabe la orden (bit 0 de S#2)
C 0x4E8C espera_al_vdp: espera a que el V9938 acabe la orden (bit 0 de S#2)
C 0x4EDA siguiente_sitio: D + 8; al dar la vuelta, E + 8
C 0x4EE4 expande_letra: una letra de 1 bit a 4 bits, en 0xE800, con el color C
C 0x4EF6 sube_un_dibujo: un dibujo de 8x8 a 4 bits (32 bytes) de HL a la VRAM de DE
C 0x4F08 copia_a_la_vram: BC bytes de HL a la VRAM de DE
C 0x4F17 sube_un_dibujo: un dibujo de 8x8 a 4 bits (32 bytes) de HL a la VRAM de DE
C 0x5030 hmmm: orden HMMM del V9938: copia BxC puntos de (H, L) a (D, E); A lleva las paginas
C 0x503A sitio_del_dibujo: H = (A & 31)*8, L = (A >> 5)*8: donde esta el dibujo A en la hoja
C 0x5042 lmmm: orden LMMM del V9938: lo mismo con operacion logica (A: paginas y operacion; 8 = TIMP)
C 0x504C sitio_del_dibujo: H = (A & 31)*8, L = (A >> 5)*8: donde esta el dibujo A en la hoja
C 0x5054 hmmm: orden HMMM del V9938: copia BxC puntos de (H, L) a (D, E); A lleva las paginas








# --- A MANO, POR TANDAS (seccion que reescribe tools/mete_notas.py desde work/notas_pNN.txt) ---
L 0x50CB dibujo_de_1_bit
L 0x50D7 fila_de_1_bit
L 0x5124 dibujo_de_2_bits
L 0x512E fila_de_2_bits
L 0x5185 dibujo_de_3_bits
L 0x518F fila_de_3_bits
C 0x50CD un byte por fila: los 8 puntos, un bit cada uno
C 0x50D0 la fila a 4 bytes de 4 bits en el buffer
C 0x50D4 las 8 filas
C 0x50D7 4 bytes de salida, dos puntos cada uno
C 0x50D9 el bit alto de la fila...
C 0x50DD ...es el color 0 o 1 de la tabla de 0xC500
C 0x50E1 el color del punto de la izquierda...
C 0x50E2 ...al nibble alto
C 0x50E8 el siguiente bit, el punto de la derecha
C 0x50F0 su color...
C 0x50F1 ...en el nibble bajo
C 0x50F2 un byte de 4 bits al buffer
C 0x50F5 los cuatro bytes de la fila
C 0x50FF un dibujo de 2 bits al buffer de 0xE800
C 0x5104 B dibujos
C 0x5115 lo mismo...
C 0x511E ...y al reves de izquierda a derecha (p00:4C12)
C 0x5126 las 8 filas del dibujo
C 0x512E cuatro bytes de salida por fila
C 0x5130 E: el plano del bit bajo
C 0x5132 D: el del bit alto
C 0x5134 el bit de D y el de E...
C 0x513B ...dan el color 0-3 de la tabla de 0xC500
C 0x513F el punto de la izquierda, al nibble alto
C 0x5146 el siguiente punto
C 0x5151 el de la derecha, al nibble bajo
C 0x5153 un byte de 4 bits al buffer
C 0x5156 los cuatro bytes de la fila
C 0x5160 un dibujo de 3 bits al buffer
C 0x5165 B dibujos
C 0x5176 lo mismo, al reves
C 0x5187 las 8 filas
C 0x518F tres planos por fila:
C 0x5191 E el bit bajo...
C 0x5193 ...D el del medio...
C 0x5195 ...y C el alto
C 0x5197 los tres bits de un punto...
C 0x51A1 ...dan el color 0-7 de 0xC500
C 0x51A5 el punto de la izquierda, al nibble alto
C 0x51AC el de la derecha
C 0x51BA su color, al nibble bajo
C 0x51BC al buffer
C 0x51BF los cuatro bytes de la fila
L 0x5446 colores_de_la_lista
L 0x54CC lista_de_dibujos
L 0x550D sube_con_formato
C 0x5446 0xFD, 0xFE o 0xFF: los colores de los dibujos de 3, 2 o 1 bits, en 0xC500
C 0x5449 0xFD: cuatro bytes, ocho colores
C 0x544D 0xFE: dos bytes, cuatro colores
C 0x5453 0xFF: un byte, dos colores
C 0x5455 cada byte son dos colores:
C 0x5457 el nibble alto...
C 0x545D ...en un sitio de 0xC500
C 0x5460 y el bajo en el siguiente
C 0x5465 los B bytes
C 0x5467 y sigue la lista
C 0x5469 base de la hoja = 32*A (0xC4B2)
C 0x546C base de la hoja = 4*A
C 0x5471 y la lista de HL
C 0x54C6 la lista, y los bancos 1-2-y el de 0xC10C al acabar
C 0x54CC LA LISTA: con los bancos 4-5-6...
C 0x54CF ...n dibujos (0 acaba)
C 0x54D5 0xFD-0xFF: colores
C 0x54DA el primer dibujo de la hoja
C 0x54DB y su propiedad, en 0xC900 + dibujo...
C 0x54E0 ...una por dibujo
C 0x54E7 el sitio del dibujo en la VRAM:
C 0x54E8 la columna (dibujo & 31) por 4 bytes...
C 0x54EE ...y la fila (dibujo >> 5) por 0x400
C 0x54F5 mas la base de la lista
C 0x54FC la fuente...
C 0x5500 ...y el tipo
C 0x5504 a subirlos
C 0x5508 la entrada siguiente, 6 bytes mas alla
C 0x550D el nibble bajo del tipo es el primer banco del trio de la fuente
C 0x5515 los tres bits altos, el formato
C 0x551C al volver, otra vez los bancos 4-5-6
C 0x5520 (un formato 8 no existe)
C 0x5523 reparte por el formato (p00:5526)
C 0x5536 0: 4 bits tal cual
C 0x553A 1: 4 bits, al reves
C 0x553E 2: 1 bit
C 0x5545 3: 1 bit, al reves
C 0x554C 4: 2 bits
C 0x5553 5: 2 bits, al reves
C 0x555A 6: 3 bits
C 0x5561 7: 3 bits, al reves
C 0x5579 como mucho 0x40 dibujos: el buffer de 0xE800 es de 2 KB
L 0x5686 sprites_del_area
L 0x5694 una_cosa_con_sprite
C 0x5686 pares [cosa][sitio] hasta 0xFF
C 0x568E sube la cosa al sitio
C 0x5694 la cosa: 6 bytes de 0x6173 (banco 7)
C 0x56A0 su ficha en 0xCF00...
C 0x56A4 ...apunta el sitio
C 0x56A7 el sitio: 8 bytes de patron cada uno desde 0xF800
C 0x56B5 el tipo: 0xFF nada, 0 RLE, 1 nada, 2+ tal cual
C 0x56C1 0: RLE a la VRAM (p00:4A8D)
C 0x56CA 2+: bytes tal cual (cuantos, en la entrada)
C 0x57B8 una fila de 8 puntos mas
C 0x57BF el byte del mapa de esta fila...
C 0x57C3 0xFF: salta a la fila de la palabra que sigue
C 0x57C6 0xFE: una puerta que depende de la fase
C 0x57C9 0xFD: lo mismo, al reves
C 0x57CD 0xFC: el mapa se para
C 0x57CE ...y ya no avanza
C 0x57D7 0xFD: si la fase ya esta hecha (0xD407), como 0xFF
C 0x57DE si no, sale el jefe (0xD404)...
C 0x57E8 ...y se apunta su fila
C 0x57EF 12 filas mas alla
C 0x57FC 0xFE: si la fase no esta hecha, como 0xFF
C 0x5806 si esta hecha, se salta la puerta: 12 filas
C 0x580E 0xFF [palabra]: el mapa sigue en esa fila
C 0x5825 el byte del mapa de la fila 0xC302: 0xC300 + fila/4
C 0x5836 el bit de la fase (p00:5847) en 0xD407
C 0x5856 5 dibujos...
C 0x5858 ...de la fila del buffer...
C 0x5866 ...a la linea de la pantalla que va a entrar por arriba
C 0x586E cada dibujo, con HMMM de la hoja
C 0x589F los 32x32 dibujos de 0xE000 a la pagina 0
C 0x58AF el dibujo...
C 0x58B1 ...con HMMM
C 0x58B4 8 puntos a la derecha
C 0x58B9 la fila siguiente, 8 lineas mas abajo
C 0x58C3 lo mismo, sin pintar los dibujos 0
C 0x58DC 0xEA00: con LMMM y el color 0 transparente
C 0x5900 EL AREA: el mapa, las superfilas y los bloques
C 0x5924 la fila con que se entra
C 0x59AD las 32 filas de la pantalla, de abajo arriba
C 0x59C2 una fila de dibujos...
C 0x59C7 ...y la de encima en el buffer (32 bytes antes, dando la vuelta)
C 0x59D9 una orden del mapa: 3 filas mas
C 0x59E5 fila/4: el byte del mapa
C 0x59F4 0xE0 en adelante: orden
C 0x59F8 la superfila: 8 bytes cada una
C 0x5A03 (fila & 3) xor 3: la fila de dibujos del bloque; la fila sube, asi que los 4 primeros bytes son la de arriba
C 0x5A1E los 8 bloques de la superfila
C 0x5A20 el bloque...
C 0x5A26 ...16 bytes cada uno...
C 0x5A2F ...y sus 4 dibujos de esta fila al buffer
C 0x4F87 texto en letras de color (la mascara C = 0xFF)
C 0x4F8B texto en blanco (C = 0)
C 0x4F8D [x][y]
C 0x4F91 la letra
C 0x4F94 0xFF acaba
C 0x4F96 0xFE: otro [x][y]
C 0x4F99 (la mascara)
C 0x4F9A la letra a la pantalla
C 0x4F9D 8 puntos a la derecha
C 0x4FA3 la letra c es el dibujo c + 0x10 de la hoja, 0x60 lineas mas abajo...
C 0x4FA8 ...y la 0, un hueco
C 0x4FB2 8x8 con HMMM de la pagina 1 a la 0
C 0x4FBE lo mismo con LMMM y el color 0 transparente
C 0x4FC8 la letra
C 0x4FCB 0xFF acaba
C 0x4FCD 0xFE: otro [x][y]
C 0x4FD0 0xFD [dx][dy]: se mueve
C 0x4FDD dx...
C 0x4FE1 ...y dy
C 0x4FE7 la letra...
C 0x4FF9 ...a la altura del scroll
C 0x5005 la letra 0: un cuadro de color 0xFF
L 0x5DFF busca_otros_cartuchos
C 0x5DFF las cuatro ranuras primarias
C 0x5E07 expandida: se miran sus cuatro secundarias
C 0x5E0C la ranura C
C 0x5E11 encontrado: se para
C 0x5E17 nada
C 0x5E35 la ranura a mirar
C 0x5E39 el Game Master o Q*bert...
C 0x5E3C ...dan 1
C 0x5E3F King Kong 2...
C 0x5E42 ...da 2
C 0x5E45 'CD 07 45 FF' en 0x4010: King Kong 2
C 0x5E4F seis bytes en 0x7FFA: el Game Master
C 0x5E5B seis bytes en 0xBFFA: Q*bert
C 0x5E63 compara B bytes de la otra ranura (RDSLT)...
C 0x5E6B ...con los de DE
C 0x5E74 todos iguales: acarreo
C 0x4735 EL MENU (con 0xC110 = 1)
C 0x4737 cursores arriba y abajo, ESPACIO y disparo recien pulsados
C 0x473D arriba o abajo: mueve el cursor (p01:6009)
C 0x4742 ESPACIO: segun la linea del cursor (0xC11B)
C 0x4749 en START: se borra el menu y al estado 3, a empezar
C 0x4756 en la linea 2: teclear las vidas...
C 0x4761 ...en la 1: teclear la fase
C 0x476F RETURN: se acepta la cifra
C 0x4777 lo tecleado...
C 0x4786 ...la cifra nueva
C 0x478D en la fase...
C 0x479D ...o en las vidas
C 0x5F51 las teclas de los numeros
C 0x5F5A del 0 al 7 en la fila 0 del teclado...
C 0x5F63 ...el 8 y el 9 en la fila 1
C 0x5F69 se borra la cifra...
C 0x5F7F ...y entra la nueva por la derecha (rld)
C 0x5F87 se pinta
C 0x5F93 las filas 0 y 1 del teclado, solo lo recien pulsado
C 0x5FB4 las dos cifras BCD de 0xC11F a binario...
C 0x5FC9 ...en 0xC11E
C 0x5FCD RETURN recien pulsada (fila 7, bit 7)
L 0x5345 lee_el_mando
C 0x5345 el puerto de mandos 1 (R#15 del PSG = 0x8F)...
C 0x534C ...y se lee (R#14): arriba, abajo, izquierda, derecha y los dos botones
C 0x5353 activos a 1
C 0x5357 la fila 4 del teclado:
C 0x535D la N (bit 3)...
C 0x5360 ...y la M (bit 2)...
C 0x5362 ...son el segundo disparo (bit 5)
C 0x5365 la fila 8: cursores y ESPACIO
C 0x536B la izquierda (bit 4) al bit 2
C 0x5373 la derecha al bit 3 y ESPACIO al 4
C 0x537B arriba y abajo a los bits 0 y 1
C 0x537F y todo junto con el mando
C 0x5318 la fila 6: F1, F2 y F3 (bits 5-7)
C 0x5323 a 0xC108 lo recien pulsado
C 0x5329 la fila 7: F4, F5, STOP...
C 0x5330 lo recien pulsado a 0xC124
C 0x5338 el mando y el teclado
C 0x533E recien pulsado = lo de ahora y no lo de antes
C 0x533F lo de ahora se guarda
C 0x5343 lo nuevo, en la direccion de antes
L 0x505B copia_dibujo_que_se_mueve
C 0x505E los dibujos 0xCC en adelante se animan: el cuadro 0-7...
C 0x5061 ...va a una columna de 0x30 en adelante...
C 0x5067 ...y la animacion a la fila (32 lineas cada una)
C 0x506F 32x8 puntos con HMMM dentro de la pagina 1
L 0x507B sitio_del_dibujo
C 0x507C x = (dibujo & 31) * 8
C 0x5083 y = (dibujo >> 5) * 8
C 0x5088 arrancando King Kong 2 la hoja esta 0x30 lineas mas arriba
C 0x5095 8 puntos a la derecha; al dar la vuelta, 8 lineas mas abajo
L 0x4853 pinta_cifras
C 0x4853 B pares de cifras BCD de HL hacia atras
C 0x4854 la de las decenas...
C 0x4858 ...y la de las unidades
C 0x485F el byte anterior
C 0x4863 la cifra c es la letra 0x30 + c
C 0x4867 con LMMM a la altura del scroll
C 0x486A 8 puntos a la derecha
C 0x486F DE = la palabra A de la tabla de DE
C 0x4878 HL = la palabra A de la tabla de HL
C 0x4893 binario de 16 bits (HL) y B a BCD en CDE
C 0x489D un bit mas...
C 0x48A1 ...y se dobla el BCD con acarreo
C 0x48B0 los 24 bits
C 0x48B3 la casilla de 0xEA00 del punto (D, E)
C 0x48BF la casilla de la pantalla 0xE000 del punto (D, E + scroll)
C 0x48C3 fila = y / 8...
C 0x48C9 ...columna = x / 8: 32 por fila
L 0x4BEC sube_un_dibujo_al_reves
C 0x4BF1 8 filas
C 0x4BF9 cada una, 4 bytes de atras adelante...
C 0x4BFC ...con los dos puntos de cada byte cambiados
C 0x4C05 la fila siguiente de la fuente
C 0x4C09 la fila siguiente de la VRAM (128 bytes)
C 0x4C12 al reves: se empieza por el ultimo byte de la primera fila
C 0x4C15 B dibujos al reves...
C 0x4C19 ...el siguiente, 4 bytes a la derecha...
C 0x4C1C ...y al llegar al borde, 8 lineas mas abajo
L 0x5B5E fundido_guarda
C 0x5B5E guarda la paleta de la VRAM (0xF680) en 0xC510
C 0x5B6A 0x80 pasos
C 0x5B70 la paleta de destino, a 0xC530
C 0x5B79 un paso del fundido: el color 0xC550 & 15...
C 0x5B88 R y B bajan uno...
C 0x5B90 ...hasta 0...
C 0x5B99 ...y G tambien
C 0x5BA4 el color al VDP
C 0x5BA7 Z cuando se acaban los pasos
C 0x5BAC un paso hacia la paleta de destino: el color C
C 0x5BB6 R...
C 0x5BC1 ...sube uno si no ha llegado
C 0x5BC7 B...
C 0x5BD3 ...sube uno si no ha llegado
C 0x5BD8 al buffer
C 0x5BDB G, igual
C 0x51C2 un trozo de la tabla de la pantalla (0xE000) desde (D, E + scroll)...
C 0x51C8 ...o de la de 0xEA00
C 0x51CF B columnas por C filas desde DE
C 0x51D7 una fila
C 0x51DE la fila siguiente, 32 mas alla, dando la vuelta a 0xE000
C 0x51EA LMMM a la altura del scroll
C 0x51F4 si el trozo pasa de la linea 255...
C 0x51FD ...se parte en dos: lo de abajo...
C 0x5210 ...y lo que da la vuelta, desde la linea 0
C 0x52A8 los sprites, la pagina de la hoja...
C 0x52AB los atributos a 0xF600...
C 0x52B1 ...y los colores a 0xF400
C 0x52B7 las copias de dibujos, de la pagina 1 a la 0
C 0x52BD el sonido y el VDP al arrancar
C 0x52C1 el mezclador del PSG: tonos si, ruido no
C 0x52CF el borde de color 15
C 0x52D4 SCREEN 5
C 0x52DC la franja de abajo (0xD8, 0x28 lineas) a 0
C 0x52E7 la pagina 1 entera a 0
C 0x52F4 4 registros del VDP de la tabla de 0x530C
C 0x52FA [registro][valor]
C 0x4F55 una letra de 1 bit (8 bytes de HL) a 4 bits en 0xE800, con el color C
C 0x4F5A una fila...
C 0x4F5D ...sus 8 puntos
C 0x4F5F 4 bytes de salida
C 0x4F61 el punto de la izquierda: el color si esta, 0 si no...
C 0x4F6D ...entra por la derecha del byte (rld)
C 0x4F6F el de la derecha, igual
C 0x4F7B ...y el byte, hecho
C 0x4F7D el siguiente byte de salida
C 0x4F80 la fila siguiente
C 0x4ADA 1: n dibujos de la VRAM, al reves y de vuelta: [vram][n][vram]
C 0x4AE1 n * 32 bytes...
C 0x4AEE ...a 0xE800...
C 0x4AF5 ...se les da la vuelta de arriba abajo en 0xEC10...
C 0x4AFA ...y de vuelta a la VRAM
C 0x4B07 2+: [fuente][n][vram] n bytes tal cual
C 0x4B1B C dibujos de 16x16 de 0xE800, volteados, a 0xEC10
C 0x4B22 la mitad izquierda...
C 0x4B25 ...16 bytes atras...
C 0x4B2C ...y la derecha
C 0x4B2F el siguiente
C 0x4B39 16 bytes con los bits al reves (el patron de un sprite al reves)
C 0x4B3B el byte...
C 0x4B3F ...bit a bit, de derecha a izquierda...
C 0x4B48 ...al destino
C 0x4906 la casilla de la pantalla del punto (D, E)...
C 0x4909 ...su dibujo...
C 0x490A ...y la propiedad del dibujo (0xC900)
C 0x490E bit 3 de la propiedad al acarreo (se choca)
C 0x4913 la propiedad del dibujo del punto (D, E)
C 0x491B Z si HL = BC
C 0x4921 Z si HL = DE
C 0x5226 HMMM a la pagina 0 que da la vuelta por abajo:
C 0x5227 si se pasa de la linea 255...
C 0x5231 ...se parte en dos: lo que cabe...
C 0x5243 ...y el resto desde la linea 0
C 0x5252 lo mismo con el origen que da la vuelta
C 0x527E y HMMV
L 0x4124 stop_congela
C 0x4124 con otro cartucho al lado: STOP (fila 7, bit 4)...
C 0x412D ...y ';' (fila 1, bit 7)
C 0x4136 lo recien pulsado
C 0x413E congelado?
C 0x4145 no: sin STOP, el cuadro normal
C 0x414A STOP: se congela...
C 0x414B ...callando el PSG
C 0x4150 congelado: ';' deja pasar un cuadro con sonido
C 0x4155 STOP otra vez: se descongela
C 0x4161 si no, sigue callado y sin cuadro
C 0x4166 guarda los volumenes de los tres canales...
C 0x417E ...y los pone a 0
C 0x4191 devuelve los volumenes
C 0x41AC pide un sonido: sin partida, y en la demostracion sin sonido (0xC13A)...
C 0x41C6 ...con los bancos 14 y 15 puestos...
C 0x41E4 ...p14:9400...
C 0x41E8 ...y los de antes
C 0x5405 los bancos 4-5-6
C 0x5408 los bancos A, A+1 y A+2: el primero...
C 0x5410 ...y su copia en RAM...
C 0x5413 ...el segundo...
C 0x5419 ...el tercero
C 0x5F93 las filas 0 y 1 del teclado...
C 0x5FA2 ...solo lo recien pulsado de la 0...
C 0x5FAB ...y de la 1
C 0x4AB0 la lista de p00:4AB0: el tipo de la entrada...
C 0x4AB2 ...0xFF acaba
C 0x4AB6 0: RLE
C 0x4AB9 1: dibujos volteados
C 0x4ABE y la siguiente
C 0x4BB3 la y de la segunda tanda de sprites...
C 0x4BB6 ...x, patron y color
C 0x4BBD el siguiente sprite de la vuelta (se alternan de 9 en 9)
C 0x4BC2 los 16
C 0x4BD1 los colores del sprite: 16 lineas de 0xE400 + 16*n...
C 0x4BD7 ...a la VRAM
C 0x4BD9 el siguiente de la vuelta
C 0x5AC0 el rotulo del titulo con los bancos 13-14-15...
C 0x5AC4 ...12x4 dibujos de p13:7D00...
C 0x5ACD ...y 9x3 de p13:7D30
C 0x5AD7 y se enciende la pantalla
C 0x47A2 el MENU: la ventana...
C 0x47A5 ...y sus variables a 0
C 0x58E7 un dibujo de 0xEA00...
C 0x58E9 ...el 0 no se pinta...
C 0x58ED ...con LMMM y el color 0 transparente
C 0x429D espera a que acabe el fundido (tres pasos por cuadro)
C 0x5DE9 BC bytes de HL a 0
# --- fin de las notas por tandas ---

